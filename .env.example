# ---------------------------------------------------------------------------
# On Me — environment
#
# Every value below is OPTIONAL. With none of them set the app runs on seeded
# fixtures shaped exactly like the Flynet staging responses, and the UI marks
# itself "SEEDED" so a demo can never imply live data it does not have.
# ---------------------------------------------------------------------------

# --- Flynet (Blackbird) -----------------------------------------------------
# Self-serve at https://make.flynet.org/ (app approval may take a while).
# The client_secret and API key are shown ONCE at creation.
# Discovery routes (restaurants, locations, hours) need only the API key.
FLYNET_API_KEY=
FLYNET_API_BASE=https://api.staging.blackbird.xyz/flynet/v1

# Member routes (check-ins, profile, wallets) use OAuth 2.0 + PKCE.
FLYNET_CLIENT_ID=
FLYNET_CLIENT_SECRET=
FLYNET_OAUTH_BASE=https://api.staging.blackbird.xyz/oauth
FLYNET_REDIRECT_URI=http://localhost:3000/api/flynet/callback

# --- Dynamic ----------------------------------------------------------------
# https://app.dynamic.xyz/ → your environment.
#   DYNAMIC_ENV_ID     Developers → SDK & API Keys → Environment ID
#   DYNAMIC_API_TOKEN  Developers → SDK & API Keys → create an API token
# Pattern used: SERVER WALLET (owned by this app's developer account, agent
# authenticates with the API token). See README "Wallet ownership".
DYNAMIC_ENV_ID=
DYNAMIC_API_TOKEN=

# Written for you by `pnpm wallet create` — do not fill these in by hand.
DYNAMIC_WALLET_PASSWORD=
DYNAMIC_WALLET_METADATA=

# Where a release is paid when no Flynet member wallet is available (member
# OAuth needs Flynet approval). Any address you control, e.g. a MetaMask
# account. Receipts say when this fallback was used.
ESCROW_FALLBACK_RECIPIENT=

# Chain the escrow settles on. Base Sepolia = 84532 (default), Base = 8453.
ESCROW_CHAIN_ID=84532
